# Required ------------------------------------------------------------------
# Neon: Dashboard → Connect → copy the connection string (pooled or direct both work)
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Any long random string (32+ chars). Keeps logins valid across restarts.
JWT_SECRET=

# AI (optional — without keys every AI step falls back to built-in rules) ----
# Several keys rotate automatically on rate limits/outages: GROQ_API_KEY_1..9 (or GROQ_API_KEYS=a,b,c)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_AGENT_MODEL=openai/gpt-oss-120b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# GEMINI_MODEL=gemini-3.8-flash
# AI_TIMEOUT=12s

# Places & flights (server-side only; never sent to the browser) --------------
GOOGLE_PLACES_API_KEY=
# Aviationstack free plan has a tiny monthly quota: cache results, never poll
AVIATIONSTACK_API_KEY=

# Server --------------------------------------------------------------------
PORT=8080
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
TIMEZONE=Asia/Kolkata
SEED_ON_START=true
DEMO_PASSWORD=demo1234
# AGENT_STEP_DELAY=700ms   pacing of the live agent timeline
# CONFIRM_TIMEOUT=90s      how long vendors get to answer in manual mode

# Super Admin (platform control: guide verification, suspending accounts) -------
# One login, checked only on the server and stored as a bcrypt hash. Sign in on the normal
# /login page (either tab). Leave empty to disable. Password: 12-72 characters. Never commit real values.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Email verification ---------------------------------------------------------
# With neither RESEND_API_KEY nor SMTP_HOST set, no code can be delivered, so new accounts are active at once.
# Set one of them to require a real 6-digit email code at sign-up.
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_FROM=Trizpyy <onboarding@resend.dev>
RESEND_API_KEY=
# or any SMTP server (Gmail app password, Brevo, Mailtrap…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where email links point (this API) and where they land afterwards (the web app)
PUBLIC_API_URL=http://localhost:8080

# Payments (optional — simulated checkout is used when empty) --------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Telegram Bot API (customer-facing document delivery)
# Create the bot with @BotFather and paste the token here. NEVER commit the real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=TrizpyyBot
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_MODE=mock
TELEGRAM_WEBHOOK_SECRET=
DEFAULT_TELEGRAM_CHAT_ID=

# Python AI service (services/ai): OR-Tools optimizer, semantic search, delay risk, vendor reliability.
# Leave empty to run without it — Go falls back to its own rules.
AI_SERVICE_URL=
AI_SERVICE_TIMEOUT=4s
# The Python AI agent (What-If explanations, ops assistant) reuses GROQ_API_KEY_* / GEMINI_API_KEY_* above.
# AGENT_LLM=0              keep the Python agent on rules only
# AGENT_LLM_TIMEOUT=12s    per LLM call inside the Python agent

# Nugen Intelligence: Trizpyy's aligned travel model (services/nugen/align.py fills NUGEN_MODEL_ID).
NUGEN_API_KEY=
NUGEN_MODEL_ID=
